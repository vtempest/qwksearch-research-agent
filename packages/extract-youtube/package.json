{
  "name": "extract-youtube",
  "version": "1.0.256",
  "description": "Fast, no-browser serverless-optimized YouTube transcript extractor",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.cjs"
    }
  },
  "bin": "dist/cli.js",
  "//files": "Publish only what consumers resolve. Without this the tarball also carries test/, jest.config.js, tsconfig*.json and vite.config.ts. Matches extract-webpage and extract-pdf.",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:lib && npm run build:cli && npm run build:react && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap",
    "build:lib": "vite build",
    "build:cli": "BUILD_CLI=true vite build",
    "build:react": "BUILD_REACT=true vite build",
    "build:bundle": "npm run build:lib && npm run build:cli && npm run build:react",
    "build:legacy": "tsc",
    "ship": "npm run build && npx standard-version --release-as patch; npm publish",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:speeds": "bun src/cli.ts dQw4w9WgXcQ -f speeds",
    "lint": "eslint src --ext .ts",
    "demo": "cd demo && npm install && npm run dev"
  },
  "keywords": [
    "youtube",
    "transcript",
    "subtitles",
    "captions",
    "api",
    "serverless",
    "lambda",
    "vercel",
    "cloudflare",
    "edge",
    "typescript",
    "youtube-transcript",
    "youtube-transcript-api",
    "srt",
    "webvtt",
    "video",
    "parsing",
    "extraction",
    "optimized"
  ],
  "author": "",
  "license": "rights.institute/PROSPER",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSourceAGI/qwksearch-research-agent.git",
    "directory": "packages/extract-youtube"
  },
  "dependencies": {
    "fast-xml-parser": "^4.2.5",
    "html-entities": "^2.3.3",
    "https-proxy-agent": "^7.0.6",
    "grab-url": "^1.6.19",
    "youtube-transcript-api": "^3.0.6"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "lucide-react": "^0.300.0 || ^1.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "lucide-react": { "optional": true }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": ">=22.12.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jest": "^29.5.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "terser": "^5.46.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
