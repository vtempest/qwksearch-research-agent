{
  "name": "research-agent-ui",
  "description": "The QwkSearch app UI: conversation window, article reader, search config, file uploads, chat history, and the app shell \u2014 exported both with and without the REASON editor and its sidebar",
  "version": "0.1.150",
  "author": "vtempest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSourceAGI/qwksearch-research-agent.git",
    "directory": "packages/research-agent-ui"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.mjs",
      "require": "./dist/workspace.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.mjs",
      "require": "./dist/config.cjs"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api.mjs",
      "require": "./dist/api.cjs"
    },
    "./file-sources": {
      "types": "./src/lib/file-sources.ts",
      "import": "./src/lib/file-sources.ts"
    },
    "./settings": {
      "types": "./src/settings/index.ts",
      "import": "./src/settings/index.ts"
    },
    "./settings/*": {
      "import": "./src/settings/*"
    }
  },
  "files": [
    "dist",
    "src/settings",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/workspace.mjs",
    "./dist/workspace.cjs"
  ],
  "scripts": {
    "build": "vite build && tsc --project tsconfig.build.json",
    "build:cloudflare": "tsc src/cloudflare/worker.ts --outDir dist/cloudflare --declaration --module esnext --target esnext --lib esnext --moduleResolution node",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev --config wrangler.local.jsonc",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy --config wrangler.local.jsonc",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "chat",
    "research-agent",
    "search",
    "article-reader",
    "shadcn",
    "react"
  ],
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18",
    "react-reason-editor": ">=1",
    "react-reason-editor-sidebar": ">=0.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@ricky0123/vad-web": "^0.0.30",
    "ai": "^5.0.0",
    "chat-agent-toolkit": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "domain-rank": "workspace:*",
    "dompurify": "^3.4.9",
    "drizzle-orm": "^0.45.2",
    "extract-webpage": "workspace:*",
    "framer-motion": "^12.40.0",
    "fuse.js": "^7.1.0",
    "grab-url": "^1.6.22",
    "html2canvas": "^1.4.1",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.17.0",
    "markdown-to-jsx": "^9.8.2",
    "motion": "^12.40.0",
    "quantum-sphere-loading-icon": "^1.0.3",
    "qwksearch-api-client": "workspace:*",
    "react-icons": "^5.6.0",
    "react-native-app-buttons": "^0.1.4",
    "react-textarea-autosize": "^8.5.9",
    "search-web-api": "workspace:*",
    "shadcn-app-dock": "workspace:*",
    "shadcn-theme-menu": "^1.1.13",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tldts": "^7.4.2",
    "trending-news-api": "workspace:*",
    "turndown": "^7.2.4",
    "use-voice-control": "^0.1.37",
    "use-weather-forecast": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250115.0",
    "@storybook/react-vite": "^9.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "easydrawer": "^0.0.18",
    "itty-router": "^5.0.24",
    "jsdom": "^28.1.0",
    "katex": "^0.17.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-reason-editor": "workspace:*",
    "react-reason-editor-sidebar": "workspace:*",
    "storybook": "^9.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.2",
    "vite": "^8.1.3",
    "vitest": "^4.0.18",
    "wrangler": "^3.88.0"
  },
  "license": "rights.institute/PROSPER",
  "peerDependenciesMeta": {
    "react-reason-editor": {
      "optional": true
    },
    "react-reason-editor-sidebar": {
      "optional": true
    }
  }
}
