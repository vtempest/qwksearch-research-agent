{
  "name": "qwksearch-api-client",
  "version": "0.9.224",
  "description": "QwkSearch API Client - Generated from openapi-docs.yml",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSourceAGI/qwksearch-research-agent.git",
    "directory": "packages/qwksearch-api-client"
  },
  "type": "module",
  "main": "./dist/api-client.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/api-client.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/api-client.js",
      "require": "./dist/api-client.umd.cjs"
    },
    "./openapi.json": "./qwksearch-openapi.json"
  },
  "scripts": {
    "ship": "npx standard-version --release-as patch; npm publish",
    "build:api": " openapi-ts && vite build",
    "test:api": "vitest",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "qwksearch-openapi.json"
  ],
  "devDependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.88.0",
    "@hey-api/vite-plugin": "^0.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "terser": "^5.44.1",
    "vite-plugin-dts": "^5.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.0.18"
  },
  "license": "rights.institute/PROSPER"
}
